# Set these through the App Platform environment settings (not loaded automatically).
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
PUBLIC_ORIGIN=https://www.example.com
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_random_password_at_least_12_chars
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=your-bucket
S3_ACCESS_KEY_ID=replace
S3_SECRET_ACCESS_KEY=replace
S3_PREFIX=uploads
